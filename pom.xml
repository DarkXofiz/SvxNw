<?xml version="1.0" encoding="UTF-8"?>
<!--
  SvxNw - RPG + SMP Minecraft Sunucu Eklentisi
  NOT: Bu dosya, İNTERNET ERİŞİMİ OLMAYAN bir sandbox içinde yazılmıştır.
  "mvn package" komutu Paper API'yi PaperMC deposundan indirmeyi dener;
  bu nedenle derleme yalnızca internet erişimi olan bir makinede doğrulanabilir.
  Ayrıntı için README.md -> "Bilinen Kısıtlar" bölümüne bakın.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.svxnw</groupId>
    <artifactId>svxnw</artifactId>
    <version>0.1.0-faz1</version>
    <packaging>jar</packaging>

    <name>SvxNw</name>
    <description>Özgün Türkçe RPG + SMP Minecraft sunucu eklentisi (Faz 1 iskeleti)</description>

    <properties>
        <!-- Paper 1.20.1 resmi olarak Java 17+ ister. -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- SÜRÜM SABİTLEME: Paper 1.20.1'in son kararlı API koordinatı.
             Gerçek ortamda `mvn -U` ile PaperMC deposundan doğrulanmalı. -->
        <paper.version>1.20.1-R0.1-SNAPSHOT</paper.version>
        <sqlite.jdbc.version>3.46.1.3</sqlite.jdbc.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API: sunucu platformu. Lisans: GPL-3.0 (PaperMC) -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- SQLite JDBC: oyuncu/ekonomi/görev verisi için. Lisans: Apache-2.0 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.jdbc.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <!-- sqlite-jdbc'yi tek jar içine gömmek için shade eklentisi -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
